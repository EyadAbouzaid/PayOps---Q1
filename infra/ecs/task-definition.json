{
  "family": "payops-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::950219439587:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::950219439587:role/payopsTaskRole",
  "containerDefinitions": [
    {
      "name": "payops-app",
      "image": "950219439587.dkr.ecr.eu-north-1.amazonaws.com/payops:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "AWS_REGION",
          "value": "eu-north-1"
        },
        {
          "name": "DB_PORT",
          "value": "5432"
        },
        {
          "name": "DB_NAME",
          "value": "payops"
        },
        {
          "name": "DB_SSL",
          "value": "true"
        },
        {
          "name": "ENABLE_EMBEDDED_WORKER",
          "value": "true"
        },
        {
          "name": "SERVE_STATIC_FRONTEND",
          "value": "true"
        }
      ],
      "secrets": [
        {
          "name": "DB_HOST",
          "valueFrom": "arn:aws:ssm:eu-north-1:950219439587:parameter/payops/prod/DB_HOST"
        },
        {
          "name": "DB_USER",
          "valueFrom": "arn:aws:ssm:eu-north-1:950219439587:parameter/payops/prod/DB_USER"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:eu-north-1:950219439587:secret:payops/db-password"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- http://127.0.0.1:3000/health || exit 1"
        ],
        "interval": 20,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/payops-task",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}