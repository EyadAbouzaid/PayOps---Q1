# Shared / Currency
CURRENCY=USD
NODE_ENV=development
LOG_LEVEL=info

# Ports (Host & Container defaults - never 3000, 5432, 6379, 9090 on host)
FRONTEND_PORT=5173
ORDER_SERVICE_PORT=4001
PRODUCT_SERVICE_PORT=4002
CART_SERVICE_PORT=4003
AUTH_SERVICE_PORT=4004
SEARCH_SERVICE_PORT=4005
PAYOPS_MOCK_PORT=3005

# Database & Redis (Own E-commerce DB - never connects to PayOps DB)
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_secret
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgres://ecommerce:ecommerce_secret@postgres:5432/ecommerce

REDIS_HOST_PORT=6380
REDIS_URL=redis://redis:6379

# Prometheus
PROMETHEUS_HOST_PORT=9091

# Auth JWT (End users only)
JWT_SECRET=super_secret_ecommerce_jwt_key_change_me
JWT_EXPIRES_IN=24h

# PayOps Integration
PAYOPS_API_URL=http://payops-mock:3005
PAYOPS_API_KEY=sk_test_demo_000000000000000000000000
PAYOPS_MODE=test
PAYOPS_WEBHOOK_SECRET=whsec_test_demo_secret_1234567890
ORDER_WEBHOOK_CALLBACK_URL=http://order-service:4001/api/webhooks/payments

# Reconciliation & Order Timeout
RECONCILE_INTERVAL_MS=120000
PENDING_ORDER_TIMEOUT_MINUTES=30
