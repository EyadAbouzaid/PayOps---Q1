# Application & Telemetry Metadata (Injected by Jenkins CI/CD)
NODE_ENV=production
PORT=3000
SERVICE_NAME=payops-api
APP_DEFAULT_MODE=test
GIT_COMMIT_SHA=local-dev
JENKINS_BUILD_NUMBER=0
AWS_REGION=eu-north-1

# PostgreSQL (AWS RDS payops-db in prod / postgres container locally)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=payops
DB_USER=payops_admin
DB_PASSWORD=change_me_in_secrets_manager
DB_SSL=false
AUTO_MIGRATE=true

# Queue & Async Worker (redis | sqs | memory)
QUEUE_DRIVER=redis
REDIS_URL=redis://redis:6379
SQS_QUEUE_URL=

# S3 Official Invoice Storage (Falls back to signed local storage if empty)
S3_BUCKET_NAME=
S3_PRESIGNED_TTL_SECONDS=900
LOCAL_INVOICE_SECRET=payops-local-invoice-signing-key

# Webhooks & Cron Security
WEBHOOK_SIGNING_SECRET=whsec_payops_hmac_sha256_secret
CRON_TRIGGER_TOKEN=cron_payops_eventbridge_token
ENABLE_EMBEDDED_WORKER=false
SERVE_STATIC_FRONTEND=true
